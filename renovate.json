{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended"],
	"customManagers": [
		{
			"customType": "regex",
			"description": "Each app in sites.json is a storytold GitHub release",
			"managerFilePatterns": ["/^sites\\.json$/"],
			"matchStrings": ["\"(?<depName>[a-z]+craft)\": \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
			"packageNameTemplate": "storytold/{{{depName}}}",
			"datasourceTemplate": "github-releases",
			"extractVersionTemplate": "^v(?<version>.+)$"
		}
	]
}
