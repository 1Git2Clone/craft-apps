{
	"name": "crafts",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"fetch-apps": "sh scripts/fetch-apps.sh",
		"precompress": "node scripts/precompress.mjs",
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "pnpm check:format && pnpm check:lint && pnpm check:types && pnpm check:lsp",
		"check:format": "vp fmt --check",
		"check:lint": "vp lint",
		"check:types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:lsp": "node scripts/lsp-check.mjs",
		"lint": "vp lint",
		"format": "vp fmt"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/language-server": "^0.16.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.19.2",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"svelte-language-server": "^0.18.4",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
		"vite-plus": "1.2.0"
	},
	"engines": {
		"node": ">=26"
	},
	"packageManager": "pnpm@12.9.0"
}
